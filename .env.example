# Copie para .env e preencha. O .env não é versionado.
BOOP_TOKEN=
# Senha do login do portal admin. Ao entrar, o servidor entrega ADMIN_BOOP_TOKEN
# (ou BOOP_TOKEN, se vazio) ao portal. Vazio = login por senha desabilitado.
ADMIN_PASSWORD=
ADMIN_BOOP_TOKEN=
# Com estas credenciais, cada login do portal gera um token novo no booprecognition
# (POST /oauth/token, grant client_credentials) em vez de usar o token fixo.
BOOP_CLIENT_ID=
BOOP_CLIENT_SECRET=
# Opcional, ex.: "identify persons:delete persons:write"
BOOP_ADMIN_SCOPE=
